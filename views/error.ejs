<%- include('partials/head', { title: title || 'Error' }) %>

<div style="min-height: 100vh; background: #F8FAFC; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.5rem;">
  <div style="width: 100%; max-width: 480px; background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 16px; padding: 2.5rem; text-align: center; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
    <div style="width: 56px; height: 56px; border-radius: 50%; background: #FEF2F2; color: #EF4444; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem;">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
    </div>
    
    <span style="font-size: 0.75rem; font-weight: 700; color: #0891B2; text-transform: uppercase; letter-spacing: 0.05em;">HTTP <%= status || 500 %></span>
    <h1 style="font-size: 1.4rem; font-weight: 800; color: #0F172A; margin: 0.35rem 0 0.5rem;"><%= title || 'Notice' %></h1>
    <p style="font-size: 0.88rem; color: #64748B; line-height: 1.5; margin-bottom: 1.5rem;"><%= message || 'The requested resource could not be loaded.' %></p>
    
    <div style="display: flex; gap: 0.75rem; justify-content: center;">
      <a href="/" class="btn-submit-action" style="text-decoration: none;">Return to Found Items</a>
      <button type="button" class="btn-cancel" onclick="window.history.back()">Go Back</button>
    </div>
  </div>
</div>

</body>
</html>
