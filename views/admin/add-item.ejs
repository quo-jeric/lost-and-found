                <path d="M9 12l2 2 4-4"></path>
              </svg>
              <span>This <%= (user?.role || (typeof role !== 'undefined' ? role : 'admin')) === 'admin' ? 'admin' : 'security officer' %> submission will be recorded in the audit log.</span>
