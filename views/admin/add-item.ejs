</div>

<!-- Toast notifications -->
<div id="toast-container" class="toast-container"></div>

<script>
  // Character counter for textarea
  function updateCharCounter(el) {
    const counter = document.getElementById('desc-char-counter');
    if (counter) {
      counter.textContent = `${el.value.length} / 300`;
    }
  }

  // Handle radio pills
  function handleStatusPillChange(input) {
    document.querySelectorAll('.radio-pill').forEach(pill => pill.classList.remove('active'));
    if (input.checked && input.closest('.radio-pill')) {
      input.closest('.radio-pill').classList.add('active');
    }
  }

  // Handle image upload selection & preview
  function handleImageFileSelect(input) {
    const file = input.files && input.files[0];
    if (!file) return;

    if (file.size > 5 * 1024 * 1024) {
      showToast('Image size exceeds 5MB limit. Please choose a smaller photo.', 'error');
      input.value = '';
      return;
    }

    const reader = new FileReader();
    reader.onload = function(e) {
      const preview = document.getElementById('upload-preview-img');
      const container = document.getElementById('upload-preview-container');
      const dropPrompt = document.getElementById('photo-dropzone-prompt');
      const filenameText = document.getElementById('preview-filename-text');

      if (preview) preview.src = e.target.result;
      if (filenameText) filenameText.textContent = file.name;
      if (container) container.classList.remove('hidden');
      if (dropPrompt) {
        dropPrompt.classList.add('hidden');
        dropPrompt.style.borderColor = '';
      }
    };
    reader.readAsDataURL(file);
  }

  function removeImagePreview() {
    const input = document.getElementById('item-image-file');
    const container = document.getElementById('upload-preview-container');
    const dropPrompt = document.getElementById('photo-dropzone-prompt');
    if (input) input.value = '';
    if (container) container.classList.add('hidden');
    if (dropPrompt) dropPrompt.classList.remove('hidden');
  }

  // Setup drag-and-drop for inline photo upload box
  document.addEventListener('DOMContentLoaded', () => {
    const dropBox = document.getElementById('photo-dropzone-prompt');
    const fileInput = document.getElementById('item-image-file');
    if (dropBox && fileInput) {
      ['dragenter', 'dragover'].forEach(eventName => {
        dropBox.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropBox.classList.add('drag-over');
        }, false);
      });
      ['dragleave', 'drop'].forEach(eventName => {
        dropBox.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropBox.classList.remove('drag-over');
        }, false);
      });
      dropBox.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt && dt.files && dt.files.length > 0) {
          fileInput.files = dt.files;
          handleImageFileSelect(fileInput);
        }
      }, false);
    }
  });

  function handleClearForm() {
    const textarea = document.getElementById('item_description');
    if (textarea) {
      setTimeout(() => updateCharCounter(textarea), 50);
    }
    const serialInput = document.getElementById('serial_number');
    if (serialInput) serialInput.value = '';
    removeImagePreview();
  }

  // Handle Post Found Item via API
  async function handlePostFoundItem(event) {
    event.preventDefault();
    const btn = document.getElementById('btn-submit-item');
    const originalText = btn.innerHTML;

    try {
      btn.disabled = true;
      btn.innerHTML = '<span>Registering...</span>';

      const categoryId = document.getElementById('category_id').value;
      const locationId = document.getElementById('location_id').value;
      const description = document.getElementById('item_description').value.trim();
      const serialNumber = document.getElementById('serial_number')?.value.trim() || null;
      const foundDate = document.getElementById('found_date').value;
      const finderName = document.getElementById('finder_name').value.trim();
      const statusPill = document.querySelector('input[name="claim_status"]:checked')?.value || 'Stored';

      if (!description) {
        showToast('Please provide an item description.', 'error');
        return;
      }

      // 1. Photo is strictly required
      const imageFileInput = document.getElementById('item-image-file');
      if (!imageFileInput || !imageFileInput.files || !imageFileInput.files[0]) {
        showToast('Please upload an item photograph. Photo is required.', 'error');
        const dropBox = document.getElementById('photo-dropzone-prompt');
        if (dropBox) {
          dropBox.style.borderColor = '#EF4444';
          dropBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return;
      }

      // Title derived from first sentence or phrase
      const title = description.length > 50 
        ? description.slice(0, 47) + '...' 
        : description;

      // Upload image file
      let uploadedImageUrl = null;
      btn.innerHTML = '<span>Uploading photo...</span>';
      const imgFormData = new FormData();
      imgFormData.append('image', imageFileInput.files[0]);

      const uploadRes = await fetch('/api/v1/items/upload', {
        method: 'POST',
        body: imgFormData,
      });

      const uploadJson = await uploadRes.json();
      if (!uploadRes.ok) {
        throw new Error(uploadJson.error?.message || uploadJson.message || 'Image upload failed');
      }
      uploadedImageUrl = uploadJson.data?.imageUrl || null;

      btn.innerHTML = '<span>Registering...</span>';

      const payload = {
        title,
        description,
        category_id: parseInt(categoryId, 10),
        location_id: parseInt(locationId, 10),
        found_at: foundDate ? new Date(foundDate).toISOString() : new Date().toISOString(),
        finder_name: finderName || 'Campus Finder',
        storage_notes: `Status: ${statusPill} - Registered via Console`,
        color: 'Neutral',
        brand: 'Standard',
        serial_number: serialNumber,
        image_url: uploadedImageUrl,
      };

      const res = await fetch('/api/v1/items', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error?.message || data.message || 'Failed to register found item');
      }

      const assignedCode = `#FI-0${data.data?.item_id || '99'}`;
      showToast(`Item ${assignedCode} successfully stored into inventory!`, 'success');

      // Display the green confirmation banner with direct Go to Inventory action
      const banner = document.getElementById('add-item-success-banner');
      const bannerMsg = document.getElementById('success-banner-msg');
      if (banner && bannerMsg) {
        bannerMsg.innerHTML = `<strong>${title}</strong> (${assignedCode}) status set to <strong>${statusPill}</strong> and logged into audit trail.`;
        banner.style.display = 'flex';
        banner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      // Prepend to recent activity stream
      const tableBody = document.querySelector('#activity-stream-table tbody');
      if (tableBody) {
        const newRow = document.createElement('tr');
        const now = new Date();
        const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
        newRow.innerHTML = `
          <td class="col-icon">
            <div class="activity-icon-badge blue">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#2563EB" stroke-width="2">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                <line x1="12" y1="22.08" x2="12" y2="12"></line>
              </svg>
            </div>
          </td>
          <td class="col-action-title">
            <strong>Found item registered</strong>
          </td>
          <td class="col-item-name">
            <span class="item-title-text">${title}</span>
            <span class="item-code-tag">&bull; ${assignedCode}</span>
          </td>
          <td class="col-officer-name"><%= user?.fullName || user?.full_name || ((user?.role || (typeof role !== 'undefined' ? role : 'admin')) === 'guard' ? 'Ana Cruz' : 'Juan Reyes') %></td>
          <td class="col-status-badge">
            <span class="status-pill-subtle stored">${statusPill}</span>
          </td>
          <td class="col-time-ago">${timeStr}</td>
        `;
        tableBody.prepend(newRow);
      }

      // Reset form fields
      document.getElementById('item_description').value = '';
      updateCharCounter(document.getElementById('item_description'));
      const serialInput = document.getElementById('serial_number');
      if (serialInput) serialInput.value = '';
      removeImagePreview();

    } catch (err) {
      showToast(err.message || 'Error submitting item', 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  }

  function showToast(msg, type = 'info') {
    const container = document.getElementById('toast-container');
    if (!container) return;
    const icons = {
      success: `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>`,
      error:   `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>`,
      info:    `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>`,
    };
    const titles = { success: 'Success', error: 'Error', info: 'Notice' };
    const toast = document.createElement('div');
    toast.className = `toast toast-${type}`;
    toast.innerHTML = `
      <div class="toast-icon-wrap">${icons[type] || icons.info}</div>
      <div class="toast-content">
        <div class="toast-title">${titles[type] || 'Notice'}</div>
        <div class="toast-message">${msg}</div>
      </div>
      <button class="toast-close-btn" onclick="this.closest('.toast').remove()" aria-label="Dismiss">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    `;
    container.appendChild(toast);
    setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transform = 'translateY(6px)';
      setTimeout(() => toast.remove(), 280);
    }, 5000);
  }
</script>
