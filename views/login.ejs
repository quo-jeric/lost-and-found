<%- include('partials/head', { title: title || 'Staff & Admin Login | CSPC Lost & Found' }) %>

  <div class="login-viewport-wrapper">
    <div class="login-card-container">
      <!-- CSPC Branding Header -->
      <div style="text-align: center; margin-bottom: 1.75rem;">
        <a href="/"
          style="display: inline-flex; align-items: center; gap: 0.75rem; text-decoration: none; margin-bottom: 1.25rem;">
          <div
            style="width: 44px; height: 44px; border-radius: 10px; border: 1.5px solid #2563EB; display: flex; align-items: center; justify-content: center; color: #2563EB; background: #FFFFFF; overflow: hidden;">
            <img src="/images/CSPCLogo.jpeg" alt="CSPC Logo"
              style="width: 100%; height: 100%; object-fit: cover; display: block;"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
            <svg style="display: none;" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor"
              stroke-width="2.2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="M9 12l2 2 4-4"></path>
            </svg>
          </div>
          <div style="text-align: left;">
            <div style="font-weight: 800; font-size: 1.25rem; color: #1D4ED8; line-height: 1.1;">CSPC</div>
            <div style="font-size: 0.8rem; font-weight: 600; color: #0F172A;">Lost & Found</div>
          </div>
        </a>
        <h1 style="font-size: 1.25rem; font-weight: 800; color: #0F172A; margin-bottom: 0.35rem;">Staff & Admin Portal
        </h1>
        <p style="font-size: 0.8rem; color: #64748B; margin: 0;">Unified access for Security Guards & System
          Administrators</p>
      </div>

      <% if (typeof error !=='undefined' && error) { %>
        <div
          style="background: #FEE2E2; border: 1px solid #FECACA; color: #B91C1C; padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.82rem; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span>
            <%= error %>
          </span>
        </div>
        <% } %>

          <!-- Quick Demo Role Fillers -->
          <div
            style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px; padding: 0.85rem; margin-bottom: 1.35rem;">
            <div
              style="font-size: 0.72rem; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; display: flex; align-items: center; justify-content: space-between;">
              <span>Quick Demo Accounts</span>
              <span style="color: #2563EB; font-weight: 600;">1-Click Fill</span>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
              <button type="button" onclick="fillCredentials('admin@cspc.edu.ph', 'Password123!')"
                style="background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 6px; padding: 0.45rem 0.6rem; text-align: left; cursor: pointer; transition: all 0.15s ease;">
                <div style="font-size: 0.76rem; font-weight: 700; color: #1D4ED8;">Admin</div>
                <div style="font-size: 0.68rem; color: #64748B;">Juan Reyes</div>
              </button>
              <button type="button" onclick="fillCredentials('guard@cspc.edu.ph', 'Password123!')"
                style="background: #FEF3C7; border: 1px solid #FDE68A; border-radius: 6px; padding: 0.45rem 0.6rem; text-align: left; cursor: pointer; transition: all 0.15s ease;">
                <div style="font-size: 0.76rem; font-weight: 700; color: #B45309;">Guard</div>
                <div style="font-size: 0.68rem; color: #64748B;">Ana Cruz</div>
              </button>
            </div>
          </div>

          <form action="/login" method="POST">
            <% if (typeof redirectUrl !=='undefined' && redirectUrl) { %>
              <input type="hidden" name="redirectUrl" value="<%= redirectUrl %>">
              <% } %>

                <div style="margin-bottom: 1.1rem;">
                  <label for="login-email"
                    style="display: block; font-size: 0.78rem; font-weight: 700; color: #334155; margin-bottom: 0.35rem;">Email
                    Address</label>
                  <input type="email" name="email" id="login-email" class="admin-text-input"
                    placeholder="admin@cspc.edu.ph" required autocomplete="email" autofocus>
                </div>

                <div style="margin-bottom: 1.5rem;">
                  <label for="login-password"
                    style="display: block; font-size: 0.78rem; font-weight: 700; color: #334155; margin-bottom: 0.35rem;">Password</label>
                  <input type="password" name="password" id="login-password" class="admin-text-input"
                    placeholder="••••••••••••" required autocomplete="current-password">
                </div>

                <button type="submit" class="btn-blue-submit"
                  style="width: 100%; justify-content: center; padding: 0.75rem; font-size: 0.9rem;">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                    <polyline points="10 17 15 12 10 7"></polyline>
                    <line x1="15" y1="12" x2="3" y2="12"></line>
                  </svg>
                  <span>Sign In to Portal</span>
                </button>
          </form>

          <div style="margin-top: 1.5rem; text-align: center; border-top: 1px solid #F1F5F9; padding-top: 1rem;">
            <a href="/" style="font-size: 0.8rem; color: #2563EB; text-decoration: none; font-weight: 600;">&larr; Back
              to Public Lost & Found</a>
          </div>
    </div>
  </div>

  <script>
    function fillCredentials(email, pwd) {
      document.getElementById('login-email').value = email;
      document.getElementById('login-password').value = pwd;
    }
  </script>

  <div id="toast-container" class="toast-container"></div>
  </body>

  </html>